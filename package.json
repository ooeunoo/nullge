{
  "name": "nullge",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:db": "node scripts/local-db.mjs",
    "db:migrate": "pnpm --filter @nullge/database migrate",
    "db:seed": "pnpm --filter @nullge/database seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @nullge/contracts build && pnpm --filter @nullge/database build && pnpm -r typecheck",
    "test": "pnpm --filter @nullge/contracts build && pnpm --filter @nullge/database build && vitest run"
  },
  "devDependencies": {
    "@nullge/contracts": "workspace:*",
    "@nullge/database": "workspace:*",
    "@types/node": "^22.19.0",
    "prettier": "^3.9.9",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
