# Local-only defaults. Production must set its own DB and Google login.
DATABASE_URL=postgres://nullge@127.0.0.1:5549/nullge_console
CONSOLE_ORIGIN=http://127.0.0.1:4310
API_INTERNAL_URL=http://127.0.0.1:4311
API_PORT=4311
CONSOLE_DEV_LOGIN=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
# One independent 32-byte hex key, identical on API and worker. Never rotate without re-encrypting data.
MARKETING_SECRET_KEY=
# Optional environment fallback. Settings-page values (including explicit deletion) override these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
GEMINI_API_KEY=
BUFFER_API_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Product-specific credentials from Meta (not the parent Facebook app credentials).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Comma-separated EXACT trusted output CDN hostnames, verified from the provider.
HIGGSFIELD_MEDIA_HOSTS=
